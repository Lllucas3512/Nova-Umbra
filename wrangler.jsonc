{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "nova-umbra",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-10-30",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "upload_source_maps": true,
    "observability": {
        "enabled": true
    }
}